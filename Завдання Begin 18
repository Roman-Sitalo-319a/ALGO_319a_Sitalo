#include <iostream>
using namespace std;

int main()
{
    // Задача: Begin 18
    double A, A2, A4, A8;

    // Введення числа A
    cout << "Enter A: ";
    cin >> A;

    // Обчислення степенів
    A2 = A * A;
    A4 = A2 * A2;
    A8 = A4 * A4;

    // Виведення результатів
    cout << "A^2 = " << A2 << endl;
    cout << "A^4 = " << A4 << endl;
    cout << "A^8 = " << A8 << endl;

    return 0;
}
